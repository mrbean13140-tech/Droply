{
  "name": "Droply",
  "short_name": "Droply",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
